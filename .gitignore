# This folder is also the CubeIDE workspace and holds unrelated files
# (other projects, personal documents). Ignore everything by default and
# only track the STM32 project's own files.
/*

!/.gitignore
!/README.md
!/LICENSE
!/Makefile
!/docs/
!/tests/
!/tools/
!/.github/
!/Mohan_Sai.ioc
!/.project
!/.cproject
!/.mxproject
!/.settings/
!/STM32F401RETX_FLASH.ld
!/STM32F401RETX_RAM.ld
!/Core/
!/Drivers/

# Not tracked on purpose:
#   Debug/, Release/  - build output, regenerated on every build
#   build/            - Makefile build output
#   .metadata/        - CubeIDE workspace state, machine-specific
#   EWARM/            - unused IAR project files

# Build output inside tracked folders
tests/build/
__pycache__/
*.pyc

# CMSIS packs that CubeMX copies in but this project never uses (DSP, NN,
# RTOS, DAP, Cortex-A, other cores' templates, HTML docs). Only
# CMSIS/Include and CMSIS/Device are needed to build.
/Drivers/CMSIS/DSP/
/Drivers/CMSIS/NN/
/Drivers/CMSIS/Core/
/Drivers/CMSIS/Core_A/
/Drivers/CMSIS/DAP/
/Drivers/CMSIS/RTOS/
/Drivers/CMSIS/RTOS2/
/Drivers/CMSIS/Documentation/
